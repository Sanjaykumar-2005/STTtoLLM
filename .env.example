# Copy this file to `.env` (same folder) and fill in the real values.
#   PowerShell:  Copy-Item .env.example .env
# `.env` is gitignored, so your endpoint URL and key never get committed.
# Real environment variables ($env:VAR) take precedence over anything here.

# --- Active client: Gemini 2.5 Flash (LLMClient = GeminiLLMClient in llm.py) ---
# Get a key from Google AI Studio. Sent as the x-goog-api-key header.
GEMINI_API_KEY=your-gemini-api-key-here

# --- Company LLM gateway (only used if you flip back to CompanyLLMClient) ---
LLM_API_BASE_URL=your_model-link
# Azure APIM subscription key (sent as the ocp-apim-subscription-key header).
LLM_API_KEY=your-subscription-key-here
